# 유튜브공장 경로 계약. scripts/activate-youtube-factory.sh가 FACTORY_ROOT를 설정한다.
OPENMONTAGE_PROJECTS_DIR=${FACTORY_ROOT}/projects
OPENMONTAGE_CACHE_DIR=${FACTORY_ROOT}/.runtime/clips_cache
MEDIA_CACHE_DIR=${FACTORY_ROOT}/.runtime/media_cache
MUSIC_LIBRARY_DIR=${FACTORY_ROOT}/music_library
TOPVIEW_HANDOFF_ROOT=${FACTORY_ROOT}/projects

# 로컬 제작 서비스. 활성화 스크립트가 기본값을 제공하며 필요할 때 .env에서 변경한다.
COMFYUI_SERVER_URL=http://127.0.0.1:8188
OPENMONTAGE_CACHE_MAX_GB=20

# 선택 제공자. 값은 실제 .env에만 기록한다.
FREESOUND_API_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=
UNSPLASH_ACCESS_KEY=

# TopView는 API가 아닌 수동 UI 핸드오프다. TopView 인증정보는 이 저장소에 저장하지 않는다.
TOPVIEW_INTEGRATION_MODE=manual_ui
