{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "openmontage/artifacts/media_collection_manifest",
  "title": "Rights-Cleared Media Collection Manifest",
  "description": "Accepted real-media files whose rights, provenance, bytes, and technical metadata are frozen before creative selection.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "collection_status",
    "generated_at",
    "queries",
    "source_summary",
    "items"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "project_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{1,95}$"},
    "collection_status": {"enum": ["completed", "partial"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "queries": {
      "type": "array",
      "items": {"$ref": "#/$defs/query"},
      "uniqueItems": true
    },
    "source_summary": {"$ref": "#/$defs/sourceSummary"},
    "items": {
      "type": "array",
      "items": {"$ref": "#/$defs/item"}
    }
  },
  "$defs": {
    "claimId": {
      "type": "string",
      "pattern": "^CLAIM_[A-Z0-9_-]{1,56}$"
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": ["query_id", "text", "kind", "claim_ids"],
      "properties": {
        "query_id": {"type": "string", "pattern": "^Q[0-9]{3,5}$"},
        "text": {"type": "string", "minLength": 2, "maxLength": 300},
        "kind": {"enum": ["image", "video", "document", "any"]},
        "claim_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/claimId"},
          "uniqueItems": true
        }
      }
    },
    "sourceSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempted",
        "completed",
        "failed",
        "discovered",
        "accepted",
        "downloaded",
        "duplicates",
        "rejected_counts"
      ],
      "properties": {
        "attempted": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "completed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "failed": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "discovered": {"type": "integer", "minimum": 0},
        "accepted": {"type": "integer", "minimum": 0},
        "downloaded": {"type": "integer", "minimum": 0},
        "duplicates": {"type": "integer", "minimum": 0},
        "rejected_counts": {
          "type": "object",
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "additionalProperties": {"type": "integer", "minimum": 1}
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "width", "height", "duration_seconds", "size_bytes"],
      "properties": {
        "format": {"type": "string", "pattern": "^[a-z0-9]{2,8}$"},
        "width": {"type": "integer", "minimum": 0},
        "height": {"type": "integer", "minimum": 0},
        "duration_seconds": {"type": "number", "minimum": 0},
        "size_bytes": {"type": "integer", "minimum": 1}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "media_type",
        "local_path",
        "sha256",
        "source",
        "source_url",
        "direct_url",
        "creator",
        "license",
        "license_url",
        "public_domain_basis",
        "attribution_required",
        "attribution_text",
        "allowed_uses",
        "accessed_at",
        "claim_ids",
        "technical"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^MEDIA_[A-Z0-9_-]{3,90}$"},
        "media_type": {"enum": ["image", "video", "document"]},
        "local_path": {
          "type": "string",
          "pattern": "^assets/source/(images|video|documents)/(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9_.-]+$"
        },
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "source": {"type": "string", "minLength": 1, "maxLength": 80},
        "source_url": {"type": "string", "format": "uri", "minLength": 1},
        "direct_url": {"type": ["string", "null"], "format": "uri"},
        "creator": {"type": "string", "maxLength": 500},
        "license": {"type": "string", "minLength": 1, "maxLength": 500},
        "license_url": {"type": ["string", "null"], "format": "uri"},
        "public_domain_basis": {"type": ["string", "null"], "minLength": 1, "maxLength": 1000},
        "attribution_required": {"type": "boolean"},
        "attribution_text": {"type": "string", "maxLength": 2000},
        "allowed_uses": {
          "type": "array",
          "minItems": 1,
          "items": {"enum": ["display", "transform", "commercial"]},
          "uniqueItems": true
        },
        "accessed_at": {"type": "string", "format": "date-time"},
        "claim_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/claimId"},
          "uniqueItems": true
        },
        "technical": {"$ref": "#/$defs/technical"}
      },
      "anyOf": [
        {"properties": {"license_url": {"type": "string", "format": "uri", "minLength": 1}}},
        {"properties": {"public_domain_basis": {"type": "string", "minLength": 1}}}
      ]
    }
  }
}
