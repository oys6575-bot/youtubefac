{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oys6575-bot/youtubefac/schemas/visual-plan.schema.json",
  "title": "MK Visual Director VisualPlan",
  "description": "Provider-independent contract between evidence, direction, production routing, graphics, editing, and human approval.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "plan_id",
    "status",
    "generated_by",
    "evidence_lock",
    "sequences",
    "approval"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "project_id": { "$ref": "#/$defs/id" },
    "plan_id": { "$ref": "#/$defs/id" },
    "status": {
      "enum": ["drafting", "awaiting_human", "approved", "rejected", "needs_revision", "superseded"]
    },
    "generated_by": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "model", "created_at"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "model": { "type": "string", "minLength": 1 },
        "created_at": { "type": "string", "format": "date-time" }
      }
    },
    "evidence_lock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_version", "status"],
      "properties": {
        "registry_version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["unlocked", "awaiting_human", "approved"] }
      }
    },
    "global_style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "aspect_ratio": { "enum": ["16:9", "9:16", "1:1", "2.39:1"] },
        "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "grammar_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        }
      }
    },
    "sequences": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sequence" }
    },
    "approval": { "$ref": "#/$defs/approval" }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^(SRC|CLAIM)_[A-Z0-9_-]{1,58}$"
    },
    "seconds": {
      "type": "number",
      "minimum": 0
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate", "status", "approved_by", "approved_at"],
      "properties": {
        "gate": {
          "enum": [
            "GATE_TOPIC",
            "GATE_SCRIPT",
            "GATE_EVIDENCE_LOCK",
            "GATE_ANIMATIC",
            "GATE_BUDGET",
            "GATE_ASSET_SELECTION",
            "GATE_FINAL_EDIT",
            "GATE_TITLE_THUMBNAIL",
            "GATE_PUBLISH"
          ]
        },
        "status": {
          "enum": ["drafting", "awaiting_human", "approved", "rejected", "needs_revision", "superseded"]
        },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } }, "required": ["status"] },
          "then": {
            "properties": {
              "approved_by": { "type": "string", "minLength": 1 },
              "approved_at": { "type": "string", "format": "date-time" }
            }
          },
          "else": {
            "properties": {
              "approved_by": { "type": "null" },
              "approved_at": { "type": "null" }
            }
          }
        }
      ]
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sequence_id",
        "purpose",
        "narration_range",
        "evidence_ids",
        "selected_grammar",
        "pacing_profile",
        "entry_transition",
        "exit_transition",
        "target_duration_seconds",
        "shots"
      ],
      "properties": {
        "sequence_id": { "$ref": "#/$defs/id" },
        "purpose": { "type": "string", "minLength": 1 },
        "narration_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start_seconds", "end_seconds"],
          "properties": {
            "start_seconds": { "$ref": "#/$defs/seconds" },
            "end_seconds": { "$ref": "#/$defs/seconds" }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceId" },
          "uniqueItems": true
        },
        "grammar_candidates": {
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "selected_grammar": { "$ref": "#/$defs/id" },
        "pacing_profile": { "enum": ["contemplative", "steady", "accelerating", "impact", "release"] },
        "entry_transition": { "$ref": "#/$defs/transition" },
        "exit_transition": { "$ref": "#/$defs/transition" },
        "target_duration_seconds": { "$ref": "#/$defs/seconds" },
        "motif_bindings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "shots": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/shot" }
        }
      }
    },
    "shot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shot_id",
        "narrative_function",
        "representation",
        "coverage_role",
        "factual_precision",
        "evidence_ids",
        "provider_route",
        "prompt_intent",
        "camera",
        "lighting",
        "continuity_bindings",
        "edit_trigger",
        "transition_in",
        "transition_out",
        "audio_layers",
        "overlay",
        "disclosure",
        "duration_seconds",
        "fallback"
      ],
      "properties": {
        "shot_id": { "$ref": "#/$defs/id" },
        "narrative_function": {
          "enum": ["hook", "context", "evidence", "reveal", "explanation", "tension", "consequence", "reflection"]
        },
        "representation": { "enum": ["REAL", "AI_RECONSTRUCTION", "GRAPHIC", "HYBRID"] },
        "coverage_role": {
          "enum": ["establishing_wide", "spatial_medium", "action_medium", "object_closeup", "material_macro", "face_detail", "evidence_insert", "hero", "transition"]
        },
        "factual_precision": { "enum": ["none", "low", "medium", "high", "exact"] },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/$defs/evidenceId" },
          "uniqueItems": true
        },
        "provider_route": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "cost_tier"],
          "properties": {
            "mode": { "enum": ["REAL_INGEST", "TOPVIEW_CANVAS", "TOPVIEW_API", "LOCAL_LTX", "HYPERFRAMES", "OPENMONTAGE_ONLY"] },
            "model_requirements": {
              "type": "array",
              "items": { "type": "string", "minLength": 1 },
              "uniqueItems": true
            },
            "cost_tier": { "enum": ["zero", "draft", "standard", "premium"] }
          }
        },
        "prompt_intent": { "type": "string", "minLength": 1 },
        "camera": { "$ref": "#/$defs/camera" },
        "lighting": {
          "type": "object",
          "additionalProperties": false,
          "required": ["family", "key_direction", "contrast"],
          "properties": {
            "family": { "type": "string", "minLength": 1 },
            "key_direction": { "enum": ["front", "side", "back", "top", "motivated_mixed"] },
            "contrast": { "enum": ["low", "medium", "high"] }
          }
        },
        "composition": { "type": "string" },
        "negative_space": { "type": "string" },
        "continuity_bindings": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "edit_trigger": {
          "enum": ["narration_clause", "music_beat", "impact", "motion", "shape", "sound_bridge", "hold", "manual"]
        },
        "transition_in": { "$ref": "#/$defs/transition" },
        "transition_out": { "$ref": "#/$defs/transition" },
        "audio_layers": {
          "type": "array",
          "items": { "$ref": "#/$defs/audioLayer" }
        },
        "overlay": { "$ref": "#/$defs/overlay" },
        "disclosure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required", "label"],
          "properties": {
            "required": { "type": "boolean" },
            "label": { "type": ["string", "null"] }
          }
        },
        "duration_seconds": { "$ref": "#/$defs/seconds" },
        "fallback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "description"],
          "properties": {
            "mode": { "enum": ["REAL", "STILL_2_5D", "LOCAL_LTX", "ALTERNATE_MODEL", "GRAPHIC", "OMIT"] },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "factual_precision": { "enum": ["high", "exact"] } }, "required": ["factual_precision"] },
          "then": { "properties": { "evidence_ids": { "minItems": 1 } } }
        },
        {
          "if": { "properties": { "representation": { "enum": ["AI_RECONSTRUCTION", "HYBRID"] } }, "required": ["representation"] },
          "then": {
            "properties": {
              "disclosure": {
                "properties": {
                  "required": { "const": true },
                  "label": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      ]
    },
    "camera": {
      "type": "object",
      "additionalProperties": false,
      "required": ["framing", "angle", "height", "lens_intent", "movement"],
      "properties": {
        "framing": { "enum": ["extreme_wide", "wide", "medium", "close", "macro", "insert"] },
        "angle": { "enum": ["front", "three_quarter", "profile", "overhead", "low", "high", "pov"] },
        "height": { "enum": ["ground", "waist", "eye", "shoulder", "overhead"] },
        "lens_intent": { "enum": ["compressed", "normal", "environmental", "macro", "orthographic"] },
        "movement": { "enum": ["locked", "slow_push", "slow_pull", "pan", "tilt", "track", "orbit", "handheld_subtle", "rack_focus"] },
        "direction": { "enum": ["none", "left_to_right", "right_to_left", "toward", "away", "clockwise", "counterclockwise"] }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "duration_seconds"],
      "properties": {
        "type": { "enum": ["cut", "impact_cut", "shape_match", "motion_match", "sound_bridge", "dissolve", "dip_to_black", "graphic_match", "none"] },
        "duration_seconds": { "$ref": "#/$defs/seconds" }
      }
    },
    "audioLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "intent"],
      "properties": {
        "type": { "enum": ["narration", "production_sound", "foley", "sfx", "ambience", "music", "silence"] },
        "intent": { "type": "string", "minLength": 1 },
        "sync_event": { "type": ["string", "null"] }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "module", "safe_area", "exact_text_from_claims"],
      "properties": {
        "mode": { "enum": ["NONE", "SEPARATE_OVERLAY", "COMPOSITED_BY_HYPERFRAMES"] },
        "module": { "enum": ["NONE", "TYPOGRAPHY", "NUMBER", "UNDERLINE", "CALLOUT", "DIAGRAM", "DOCUMENT", "ARCHIVE_FRAME", "RECONSTRUCTION_LABEL"] },
        "safe_area": { "enum": ["none", "title", "action", "custom"] },
        "exact_text_from_claims": { "type": "boolean" }
      }
    }
  }
}
