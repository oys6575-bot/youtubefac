{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oys6575-bot/youtubefac/schemas/source-registry.schema.json",
  "title": "MK Visual Director Source Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "registry_version", "project_id", "sources", "claims"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "registry_version": { "type": "string", "minLength": 1 },
    "project_id": { "$ref": "#/$defs/id" },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    },
    "claims": {
      "type": "array",
      "items": { "$ref": "#/$defs/claim" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_-]{2,63}$"
    },
    "sourceId": {
      "type": "string",
      "pattern": "^SRC_[A-Z0-9_-]{1,58}$"
    },
    "claimId": {
      "type": "string",
      "pattern": "^CLAIM_[A-Z0-9_-]{1,56}$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "title",
        "publisher",
        "source_type",
        "locator",
        "retrieved_at",
        "rights",
        "credibility_tier",
        "local_copy"
      ],
      "properties": {
        "source_id": { "$ref": "#/$defs/sourceId" },
        "title": { "type": "string", "minLength": 1 },
        "publisher": { "type": "string", "minLength": 1 },
        "publication_date": { "type": ["string", "null"], "format": "date" },
        "capture_date": { "type": ["string", "null"], "format": "date" },
        "source_type": { "enum": ["official_record", "museum", "academic", "book", "news", "interview", "photo", "video", "drawing", "community", "provider_documentation", "other"] },
        "locator": { "type": "string", "minLength": 1 },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "rights": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "license", "allowed_uses", "attribution_required"],
          "properties": {
            "status": { "enum": ["verified", "restricted", "permission_required", "unknown"] },
            "license": { "type": ["string", "null"] },
            "allowed_uses": { "type": "array", "items": { "enum": ["research", "reference_only", "transform", "display", "commercial"] }, "uniqueItems": true },
            "attribution_required": { "type": "boolean" },
            "notes": { "type": "string" }
          }
        },
        "credibility_tier": { "type": "integer", "minimum": 1, "maximum": 5 },
        "local_copy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "sha256"],
          "properties": {
            "path": { "type": ["string", "null"] },
            "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_id", "text", "citations", "confidence", "status", "visualizable"],
      "properties": {
        "claim_id": { "$ref": "#/$defs/claimId" },
        "text": { "type": "string", "minLength": 1 },
        "citations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "pinpoint", "relationship", "support_note"],
            "properties": {
              "source_id": { "$ref": "#/$defs/sourceId" },
              "pinpoint": {
                "type": "string",
                "minLength": 1,
                "description": "Page, section, figure, timestamp, archive item, or another exact locator."
              },
              "relationship": { "enum": ["supports", "contradicts", "context_only"] },
              "support_note": { "type": "string", "minLength": 1 },
              "excerpt_sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" }
            }
          }
        },
        "confidence": { "enum": ["low", "medium", "high"] },
        "status": { "enum": ["unverified", "needs_evidence", "verified", "disputed", "rejected"] },
        "visualizable": { "type": "boolean" },
        "uncertainty_note": { "type": ["string", "null"] }
      }
    }
  }
}
